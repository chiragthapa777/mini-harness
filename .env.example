# Postgres — SQL store and vector store (pgvector) are the same database.
# Matches the defaults in docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/mini_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mini_agent
# 5432 is often taken by another project; ours maps to 5433 on the host
POSTGRES_PORT=5433

# LLM provider, reached through packages/llm.
# openrouter | openai | anthropic | google
AGENT_PROVIDER=openrouter
AGENT_MODEL=z-ai/glm-5.3-flash
AGENT_MAX_TOKENS=16000

# OpenRouter is the OpenAI wire format at a different base URL.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=mini-agent
OPENROUTER_SITE_URL=

# Only needed if AGENT_PROVIDER is switched to one of these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Embeddings for semantic + episodic vector search.
# OpenRouter does not serve an embeddings endpoint — this key is separate from
# the chat provider. Leave EMBEDDINGS_BASE_URL empty for OpenAI itself.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# Web search and page scraping — no key, no account.
# DuckDuckGo is the only backend today; SEARCH_PROVIDER exists so a keyed one
# (Tavily, Serper) or a self-hosted SearXNG can be dropped in without changing
# any call site. See packages/search/src/client.ts.
SEARCH_PROVIDER=duckduckgo
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_MS=10000
# Region hint (DuckDuckGo `kl`) and off | moderate | strict
SEARCH_REGION=us-en
SEARCH_SAFE_SEARCH=moderate
SCRAPE_MAX_CHARS=8000

# API server
PORT=3001

# Auth — JWTs signed on login, verified on every protected route.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# There is no public register route. Set these to seed one admin account at
# startup (a no-op once that account exists); every other user is created by
# an admin from there via POST /admin/users.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Account lockout after repeated failed logins.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# End-loop guardrails
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOKENS_PER_RUN=100000

# Memory
CONSOLIDATE_AFTER_N_MESSAGES=20
EPISODIC_RECENT_LIMIT=10
RAG_TOP_K=5
SKILLS_DIR=skills

# Versioned config released by the ops loop
PROMPT_VERSION=1

# Background jobs (apps/worker). The queue is the `jobs` table in the same
# Postgres — no broker, no second datastore.
# JOBS_ENABLED=false makes every producer do its work inline instead of
# enqueueing it, so the API keeps working with no worker deployed.
JOBS_ENABLED=true
JOB_POLL_INTERVAL_MS=2000
JOB_BATCH_SIZE=5
JOB_MAX_ATTEMPTS=3
# Retry backoff: base * 2^(attempt-1), capped at JOB_RETRY_MAX_MS.
JOB_RETRY_BASE_MS=30000
JOB_RETRY_MAX_MS=900000
# A job still 'running' after this long is assumed to have died with its worker
# and goes back on the queue.
JOB_STALE_AFTER_MS=600000

# Scheduling. The scheduler only enqueues jobs — the worker loop runs them.
# Run it on exactly one worker if you deploy several (SCHEDULER_ENABLED=false
# on the rest). All cron expressions are 5-field and UTC.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MS=30000
# Fold new messages into each conversation's summary + episodic event.
SUMMARIZE_CRON=*/5 * * * *
# Distil unconsolidated messages into semantic facts.
CONSOLIDATE_CRON=*/15 * * * *
# Merge near-duplicate facts.
DEDUPE_FACTS_CRON=30 3 * * *
# Re-enqueue rows whose embedding never landed.
EMBED_BACKFILL_CRON=*/10 * * * *
