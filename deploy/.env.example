# mini-agent deployment — copy to `.env` next to docker-compose.yml.
#
# Only what a deployment needs. The full list of every variable the project
# reads, with explanations, is in ../.env.example.

# --- images ---------------------------------------------------------------
# Leave VERSION as `latest` and you never touch it again: the release workflow
# moves that tag to each new non-prerelease version, every service pulls on
# start, so `docker compose up -d` is the whole upgrade.
#
# Set it to an exact release (VERSION=0.1.0) for the opposite trade — the
# deployment then only changes when you edit this line, which is what you want
# if a surprise restart picking up new code would be unwelcome.
REGISTRY=ghcr.io/chiragthapa777/mini-harness
VERSION=latest

# Host port for the web UI. Put your TLS terminator in front of this.
WEB_PORT=8080

# The API. API_PORT is the port it listens on inside the network and the one
# nginx forwards /api to — the two have to agree, so both read this one value.
# API_HOST_PORT is where it appears on the host; the UI never uses it, so it is
# only for reaching the API directly, and the `ports:` entry can be dropped.
API_PORT=3001
API_HOST_PORT=3001

# --- database -------------------------------------------------------------
# Postgres is not exposed to the host; this password is for the compose network.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=mini_agent

# --- model access ---------------------------------------------------------
AGENT_PROVIDER=openrouter
AGENT_MODEL=z-ai/glm-5.3-flash
OPENROUTER_API_KEY=

# Embeddings are a separate provider — OpenRouter serves no embeddings
# endpoint. Without this, memory falls back to recency and RAG is off.
EMBEDDINGS_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- auth -----------------------------------------------------------------
# Signs every token. Generate one: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Seeds one admin account on first boot. There is no public sign-up; every
# other account is created from the admin panel.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- background work ------------------------------------------------------
# JOBS_ENABLED=false makes the API do everything inline, for a deployment with
# no worker. SCHEDULER_ENABLED must be true on exactly one worker.
JOBS_ENABLED=true
SCHEDULER_ENABLED=true
