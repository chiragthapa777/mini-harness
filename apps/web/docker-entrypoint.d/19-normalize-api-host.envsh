#!/bin/sh
# Normalises API_HOST before the template is rendered.
#
# API_HOST is a Docker service name — `api` — because the browser never uses
# it: the frontend calls relative /api paths and this container proxies them.
# That is not obvious from the outside, so the value arrives as a URL often
# enough to be worth handling: `http://1.2.3.4/` renders
# `proxy_pass http://http://1.2.3.4/:3001` and nginx exits at startup with
# "invalid port in upstream", which reads like a bug in the image rather than
# a wrong variable.
#
# Sourced, not executed — the nginx entrypoint only sources *.envsh, and an
# executed script could not export anything back into the environment that
# 20-envsubst-on-templates.sh then reads.

_host="${API_HOST:-api}"

# Strip a scheme, then anything from the first slash on: `https://api/x` -> `api`.
_host="${_host#http://}"
_host="${_host#https://}"
_host="${_host%%/*}"

# A host:port pair carries its own port, and that beats API_PORT — someone who
# writes `api:4000` means 4000.
case "$_host" in
  *:*)
    API_PORT="${_host##*:}"
    _host="${_host%%:*}"
    ;;
esac

export API_HOST="$_host"
export API_PORT="${API_PORT:-3001}"

# Docker's embedded DNS, so the upstream is re-resolved rather than pinned to
# the IP the api container happened to have at boot. Read from resolv.conf so
# this still works outside Docker's default 127.0.0.11.
API_RESOLVER="$(awk '/^nameserver/ { print $2; exit }' /etc/resolv.conf 2>/dev/null)"
export API_RESOLVER="${API_RESOLVER:-127.0.0.11}"

echo "19-normalize-api-host.envsh: proxying /api to ${API_HOST}:${API_PORT} (resolver ${API_RESOLVER})"
