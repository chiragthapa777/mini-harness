{
  "name": "mini-agent",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" --filter \"!@mini-agent/tui\" dev",
    "dev:tui": "pnpm --filter @mini-agent/tui dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:schema": "psql postgres://postgres:postgres@localhost:5433/mini_agent -f packages/db/schema.sql",
    "test": "pnpm -r test",
    "pw:generate":"pnpm --filter @mini-agent/api hash-password"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
